{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "RabbitMQDemo": "Information"
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ClientProvidedName": "rabbitmq-demo-subscriber",
    "HeartbeatInterval": 30,
    "AutomaticRecoveryEnabled": true,
    "RetryCount": 5,
    "RetryBaseDelaySeconds": 1,
    "PublisherConfirms": true,
    "Mandatory": true,
    "DeliveryMode": 2,
    "Ssl": {
      "Enabled": false
    },
    "Consumer": {
      "PrefetchCount": 10,
      "AutoAck": false,
      "Retry": {
        "MaxRetryCount": 3,
        "BaseDelaySeconds": 1,
        "MaxDelaySeconds": 30
      }
    }
  },
  "Dashboard": {
    "BaseUrl": "http://localhost:5100"
  }
}
